{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs.html",
      "destination": "/docs.html"
    },
    {
      "source": "/((?!docs|docs\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "github": {
    "enabled": true,
    "silent": true
  }
}
